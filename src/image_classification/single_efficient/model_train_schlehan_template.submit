#!/bin/bash
#SBATCH --time=1000
#SBATCH --job-name=resnet_rgz
#SBATCH --ntasks=1
#SBATCH --nodes=1
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=1
#SBATCH --account=cai_ivs
#SBATCH --partition=gpu
#SBATCH --nodelist=sandiego
#SBATCH --output=/cluster/home/schlehan/temp/%j_%N__RNN.out
#SBATCH --error=/cluster/home/schlehan/temp/%j_%N__RNN.err


env_name="ML4GLEAM"
venv_base_dir="/raid/persistent_scratch/schlehan/venvs/"
venv_path="$venv_base_dir/$env_name"

# create venv base dir if it does not exist
mkdir -p /raid/persistent_scratch/schlehan/venvs/


if [ -d "$venv_path" ]; then
    echo "Virtual environment ($env_name) found. Activating..."
    unset PIP_TARGET
    unset PYTHONPATH
    source "$venv_path/bin/activate"
    pip install --upgrade pip
    pip install -r /raid/persistent_scratch/schlehan/jobs/efficient_net_single2/ML4GLEAM/src/requirements_venv/requirements.txt
else
    echo "Virtual environment ($env_name) not found. Creating..."
    module load python/3.11.9
    virtualenv $venv_path
    # added from ex06, git repo from denp
    unset PIP_TARGET
    unset PYTHONPATH
    source "$venv_path/bin/activate"
    pip install --upgrade pip
    pip install -r /raid/persistent_scratch/schlehan/jobs/efficient_net_single2/ML4GLEAM/src/requirements_venv/requirements.txt

fi

export PYTHONPATH=/raid/persistent_scratch/schlehan/jobs/efficient_net_single2/ML4GLEAM/src:$PYTHONPATH

python3 -u /raid/persistent_scratch/schlehan/jobs/efficient_net_single2/ML4GLEAM/src/image_classification/schlehan/single_efficient/single_experiment_script_schlehan.py